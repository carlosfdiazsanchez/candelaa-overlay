{
  "name": "candelaa-overlay",
  "version": "0.2.24",
  "description": "Overlay unificado para Albion Online (radar + jugadores + mercado + crafting)",
  "author": "Candelaa",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean:dist": "node -e \"const fs=require('fs'),d='dist';if(fs.existsSync(d)){const g=fs.readdirSync(d).filter(f=>f.endsWith('.exe')||f.endsWith('.blockmap'));g.forEach(f=>fs.rmSync(d+'/'+f));console.log('removed '+g.length+' stale installers')}\"",
    "dist": "npm run clean:dist && electron-builder --win",
    "publish": "npm run clean:dist && electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.candelaa.overlay",
    "productName": "Candelaa Overlay",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "i18n.js",
      "renderer.js",
      "players-feed.js",
      "resources-feed.js",
      "item-feed.js",
      "app-key.json",
      "data/**/*",
      "images/**/*",
      "!**/*.log"
    ],
    "extraResources": [
      {
        "from": "vendor/radar",
        "to": "radar"
      },
      {
        "from": "vendor/market",
        "to": "market"
      },
      "THIRD-PARTY-NOTICES.txt"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Candelaa Overlay"
    },
    "publish": {
      "provider": "github",
      "owner": "carlosfdiazsanchez",
      "repo": "candelaa-overlay",
      "releaseType": "release"
    }
  }
}
